{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "myimoguide",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Producer: the webhook enqueues here and returns 200 immediately.
	// Consumer: the same Worker drains it and does the slow LLM work.
	"queues": {
		"producers": [
			{
				"queue": "myimoguide-inbound",
				"binding": "INBOUND"
			}
		],
		"consumers": [
			{
				"queue": "myimoguide-inbound",
				// One message per invocation. If an invocation is killed, only
				// that message is lost to the retry, not four innocent ones in
				// the same batch. Queue operations are counted per message, so
				// this costs nothing against the free plan's daily allowance.
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"dead_letter_queue": "myimoguide-inbound-dlq"
			},
			{
				// The backstop. Messages land here only when every attempt
				// failed without delivering a reply; its handler sends a short
				// apology so a user is never left with silence.
				"queue": "myimoguide-inbound-dlq",
				"max_batch_size": 1,
				"max_retries": 2
			}
		]
	},
	// Per-conversation state: SQLite-backed Durable Objects are on the free
	// plan; the KV-backed ones are not. Do not change the class without a
	// matching migration entry.
	"durable_objects": {
		"bindings": [
			{
				"name": "CONVERSATION",
				"class_name": "Conversation"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Conversation"
			]
		}
	],
	// Source documents behind each verified record (gazette PDFs, fee
	// schedules) so the dashboard can show provenance.
	"r2_buckets": [
		{
			"binding": "SOURCES",
			"bucket_name": "myimoguide-sources"
		},
		{
			"bucket_name": "myimoguide-sources",
			"binding": "myimoguide_sources",
			"remote": true
		}
	],
	"vars": {
		"WHATSAPP_API_VERSION": "v23.0",
		"LOG_LEVEL": "info"
		// Optional, see docs/switching-providers.md and docs/phase-4-voice-notes.md:
		//   MODEL_PROVIDER, ROUTING_MODEL, SYNTHESIS_MODEL   answering
		//   TRANSCRIBE_PROVIDER, TRANSCRIBE_MODEL            voice notes (default openai, gpt-transcribe)
	}
	// Secrets (never in this file — `wrangler secret put <NAME>`):
	//   WHATSAPP_VERIFY_TOKEN   random string, also pasted into Meta's webhook config
	//   WHATSAPP_APP_SECRET     Meta app secret, used for X-Hub-Signature-256
	//   WHATSAPP_TOKEN          System User token (permanent, not the 60-min one)
	//   WHATSAPP_PHONE_ID       phone number ID (not the phone number)
	//   ANTHROPIC_API_KEY
	//   OPENAI_API_KEY          voice notes always; answers too when MODEL_PROVIDER is "openai"
	//   DATABASE_URL            Neon pooled connection string
	//   TOTP_ENCRYPTION_KEY     32 random bytes, base64; encrypts dashboard 2FA secrets
}
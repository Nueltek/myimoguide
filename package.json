{
  "name": "myimoguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "size": "node scripts/check-bundle-size.mjs",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:facts": "tsx scripts/seed-facts.ts",
    "db:seed:services": "tsx scripts/seed-services.ts",
    "db:seed": "npm run db:seed:facts && npm run db:seed:services",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e": "esbuild scripts/e2e-admin.ts --bundle --platform=node --format=esm --jsx=automatic --jsx-import-source=hono/jsx --outfile=.test-build/e2e.mjs --external:@electric-sql/pglite --log-level=error && node .test-build/e2e.mjs",
    "test:dedupe": "tsx scripts/test-dedupe.ts",
    "test": "npm run test:dedupe && npm run test:e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/openai": "^4.0.110",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.163",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
